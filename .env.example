# Server
PORT=3008
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/alagare

# JWT (mobile app users)
JWT_SECRET=alagare-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# OTP emails (Postmark)
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=support@alagare.com
POSTMARK_MESSAGE_STREAM=outbound

# Cloudinary (profile images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
